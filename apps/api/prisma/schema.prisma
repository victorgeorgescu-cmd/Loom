// Loom data model. Postgres from day one.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  slug           String    @id
  name           String
  contextMd      String
  styleMd        String
  featuredPerson String? // non-null ⇒ image-gen guardrail applies
  footerAddress  String? // CAN-SPAM; null ⇒ export placeholder gate fails
  tidConvention  String?
  products       Product[]
  projects       Project[]
}

model Template {
  id           String    @id
  campaignType String
  html         String
  slots        Json
  projects     Project[]
}

model Project {
  id           String         @id @default(cuid())
  brand        Brand          @relation(fields: [brandSlug], references: [slug])
  brandSlug    String
  template     Template       @relation(fields: [templateId], references: [id])
  templateId   String
  campaignType String
  brief        String
  html         String // canonical edited HTML — source of truth
  status       String         @default("draft") // draft | ready
  assets       ProjectAsset[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ProjectAsset {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  kind      String // "hero" | ...
  url       String
  prompt    String?
  bytes     Int?
  createdAt DateTime @default(now())
}

model Product {
  id          String  @id @default(cuid())
  brand       Brand   @relation(fields: [brandSlug], references: [slug])
  brandSlug   String
  name        String
  description String
  images      Json // [{ url, alt, isReference }]
}
