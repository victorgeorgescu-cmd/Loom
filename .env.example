# ── Database ─────────────────────────────────────────────
# Local dev via docker-compose (see docker-compose.yml) or your own Postgres.
DATABASE_URL=postgresql://loom:loom@localhost:5432/loom?schema=public

# ── Anthropic (email copy + structure) ───────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional override (proxy/gateway). Leave unset to use the default endpoint.
# ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI (image generation) ────────────────────────────
OPENAI_API_KEY=sk-...
# Confirm the id your account actually has access to (org verification required).
# Do NOT assume gpt-image-2 exists — default to a confirmed-live id.
IMAGE_MODEL=gpt-image-1

# ── Cloudflare R2 (image hosting, S3-compatible) ─────────
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=loom-email-images
# Public base URL — MUST be a custom domain for production sends.
# r2.dev is rate-limited and not for production.
R2_PUBLIC_BASE_URL=https://images.example.com

# ── Server ───────────────────────────────────────────────
PORT=8787
