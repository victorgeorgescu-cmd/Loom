{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @loom/api prisma:generate"
  },
  "deploy": {
    "startCommand": "pnpm --filter @loom/api migrate:deploy && pnpm --filter @loom/api start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
